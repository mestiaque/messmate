# Production environment template. Copy to .env on the server, fill every blank,
# then run: php artisan key:generate && php artisan messmate:install
APP_NAME=MessMate
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://messmate.example.com
# Set when a load balancer / reverse proxy terminates TLS, e.g. 10.0.0.5 or *
TRUSTED_PROXIES=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# Daily files kept 14 days; errors only. Point LOG_STACK at a remote channel if you use one.
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_LEVEL=warning
LOG_DEPRECATIONS_CHANNEL=null

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=messmate
DB_USERNAME=messmate
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
# Receipts and other private files live on the "local" disk (storage/app/private); never public.
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database
CACHE_PREFIX=messmate_

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="billing@messmate.example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Only the manual (bank / bKash transfer) provider in production. Never enable "sandbox".
BILLING_PROVIDERS=manual
BILLING_SANDBOX_SECRET=
